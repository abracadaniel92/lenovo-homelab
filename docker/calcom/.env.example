# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Generate secrets with:
#   NEXTAUTH_SECRET:          openssl rand -base64 32
#   CALENDSO_ENCRYPTION_KEY:  openssl rand -base64 24
#   POSTGRES_PASSWORD:        openssl rand -hex 24

NEXT_PUBLIC_WEBAPP_URL=https://cal.gmojsoski.com
NEXTAUTH_URL=https://cal.gmojsoski.com
NEXTAUTH_SECRET=
CALENDSO_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

CALCOM_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LICENSE_CONSENT=agree

# Gmail: EMAIL_SERVER_PASSWORD is an app password, not the account password.
# Generate at https://myaccount.google.com/apppasswords (needs 2FA enabled).
EMAIL_FROM=
EMAIL_FROM_NAME=Cal
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Google Calendar + Google Meet. Single-line JSON, must keep the "web" wrapper:
#   {"web":{"client_id":"...","client_secret":"...","redirect_uris":["https://cal.gmojsoski.com/api/integrations/googlecalendar/callback"]}}
# scripts/seed-app-store.ts reads this on every container start and seeds BOTH
# the google-calendar and google-meet apps from it. Setting the credentials via
# the admin UI instead seeds only google-calendar, leaving Meet unavailable.
# The redirect_uris entry must exactly match the Authorized redirect URI in the
# Google Cloud console, or the OAuth flow fails with redirect_uri_mismatch.
GOOGLE_API_CREDENTIALS=
