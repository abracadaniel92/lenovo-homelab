# Offsite drive (Toshiba MQ04ABD200 in the Verbatim USB enclosure): APM 254
# every time it appears (boot, power cut, replug). /etc/hdparm.conf can't do
# this: Debian's hdparm udev hook skips APM on USB disks (log 2026-10-21).
# Install: sudo install -m 0644 99-offsite-apm.rules /etc/udev/rules.d/
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_SERIAL_SHORT}=="56HRP1HST", RUN+="/usr/sbin/hdparm -B 254 $devnode"
