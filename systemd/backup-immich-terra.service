[Unit]
Description=Back up Immich + /mnt/ssd/backups to the Terra (restic, append-only)
Wants=network-online.target wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service
RequiresMountsFor=/mnt/ssd_1tb /mnt/ssd
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# Path goes through the /opt/homelab symlink on purpose (troubleshooting-log 2026-09-25).
ExecStart=/opt/homelab/scripts/backup-immich-terra.sh
Nice=10
IOSchedulingClass=idle
